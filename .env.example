# Vite environment variables (exposed to client when VITE_ prefix is used)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_N8N_WEBHOOK_URL=

# Optional: OpenRouter and Hugging Face
VITE_OPENROUTER_API_KEY=
VITE_HF_API_KEY=
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
VITE_HF_RESPONSE_MODEL=CohereLabs/command-a-reasoning-08-2025

# Note: Create a .env.local file with your actual values
# Do not commit the .env.local file to version control