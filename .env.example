# Vite environment variables (exposed to client when VITE_ prefix is used)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_N8N_WEBHOOK_URL=

# Browser bundles must never contain provider API keys. Configure a server-side
# proxy and expose only its URL to the client.
VITE_AI_PROXY_URL=
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
VITE_HF_RESPONSE_MODEL=CohereLabs/command-a-reasoning-08-2025

# Create .env.local with local values. Never commit it.